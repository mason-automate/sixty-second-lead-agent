# Copy to .env.local and fill in. Never commit real keys.

# --- Sent (https://sent.dm) -------------------------------------------------
# Dashboard -> API keys. Sent as the `x-api-key` header on every request.
SENT_API_KEY=
SENT_API_BASE=https://api.sent.dm/v3

# Signing secret for the webhook endpoint, printed by `npm run webhook` (or
# POST /v3/webhooks/{id}/rotate-secret). If unset, signature checking is SKIPPED
# and the receiver logs a warning — fine locally, not fine in production.
SENT_WEBHOOK_SECRET=

# Set to "false" to process deliveries that fail signature verification instead
# of rejecting them with a 401. Rejecting is the right default; this exists
# because rejecting also blocks the traffic you need in order to debug the
# signature in the first place. Leave it unset in production.
#
# Worth knowing: a single non-2xx response permanently stops a Sent webhook from
# dispatching, while it keeps reporting is_active: true. Recovery is to delete
# and re-register it.
SENT_WEBHOOK_ENFORCE=

# How the first message goes out:
#   template — send a Meta-approved template (default, and the only mode that
#              works for a lead you have not heard from yet).
#   text     — send Claude's draft verbatim. Only valid once the contact has
#              messaged you, which opens the session window.
#
# Messaging platforms separate business-initiated messages from replies inside
# an open conversation. A cold free-form send is rejected: the API returns
# success and QUEUED, then the message FAILS about 37ms later with no reason
# given, so this looks like it works right up until nothing arrives.
#
# The conversation flow satisfies the rule on its own — the template goes out
# first, the lead's reply opens the window, and every message after that is
# free-form. So leave this alone unless you know the contact has replied.
SENT_FIRST_MESSAGE_MODE=template

# The approved template sent as that first message. It must EXIST in your own
# Sent account and be approved — see "Create the two templates" in the README.
# It takes one variable, {{name}}.
SENT_TEMPLATE_NAME=lead_response

# --- Abuse guards -----------------------------------------------------------
# /api/leads is public, unauthenticated, and sends a real SMS when called. On a
# registered A2P number, unsolicited traffic is how campaigns get suspended.
#
# Comma-separated origins allowed to submit from a browser. Unset = any, which
# is fine locally. Set it once deployed. Requests with no Origin header (a
# server-side form relay) are always allowed and bounded by the limits below.
ALLOWED_ORIGINS=

# Defaults are deliberately conservative. Raise them only if you understand
# what you are giving out — MAX_PER_NUMBER especially, since it is what stops
# this endpoint being used to text a stranger over and over.
LEADS_MAX_PER_IP=5        # per hour
LEADS_MAX_PER_NUMBER=3    # per day
LEADS_MAX_PER_DAY=50      # per day, whole deployment

# --- Claude (https://platform.claude.com) -----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Cal.com booking (optional) ---------------------------------------------
# Leave CAL_API_KEY empty and booking stays off: the agent still converses and
# still records the time the lead asked for, it just says a person will confirm
# instead of putting anything on a calendar. Nothing else changes.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=            # numeric id of the event type to book
CAL_TIMEZONE=America/Denver   # IANA zone the lead's times are read in
CAL_API_BASE=https://api.cal.com/v2

# Cal.com pins its API per endpoint via a `cal-api-version` header, and their
# own docs have published conflicting values for both of these. Sending the
# wrong one does NOT error — it silently selects an older response shape, which
# shows up as "no times available" rather than as a failure. They are config so
# that a version bump is an env change, not a redeploy of new code.
CAL_API_VERSION_SLOTS=2024-09-04
CAL_API_VERSION_BOOKINGS=2024-08-13

# The Meta-approved template sent once a call is actually booked. Its
# {{name}}/{{date}}/{{time}} variables are filled from the booking itself.
SENT_BOOKING_TEMPLATE=booking_confirmation

# --- Storage (optional) -----------------------------------------------------
# Vercel functions are stateless, so the webhook receiver and the status panel
# run in different invocations. Without these the app uses an in-memory store,
# which is correct for `npm run dev` and wrong for production.
# Get them free at https://upstash.com (Vercel's Upstash integration injects the
# KV_REST_API_* aliases automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
